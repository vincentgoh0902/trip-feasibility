# Copy to .env (gitignored). Compose and the backend read it.
DATABASE_URL=postgresql+asyncpg://trip:trip@localhost:5432/trip
PORT=8000
# Parse step 1 (Claude). Set a monthly spend cap in the Anthropic Console first.
ANTHROPIC_API_KEY=
# Sign-in: the Next.js server signs a short-lived token per API call with this (32+ chars).
API_JWT_SECRET=
# Langfuse Cloud tracing (optional; off unless both are set). No itinerary text is sent
# unless TRACE_CONTENT=true.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
